# Financito is local-only. Never bind to 0.0.0.0.
FINANCITO_HOST=127.0.0.1
FINANCITO_PORT=8765
FINANCITO_DATA_DIR=~/.financito
FINANCITO_VAULT_DIR=~/.financito/vault
FINANCITO_LOCAL_AI_URL=http://127.0.0.1:11434
FINANCITO_LOCAL_AI_MODEL=

# DEVELOPMENT/TESTS ONLY. Production must use an encrypted SQLite/SQLCipher build
# or another storage implementation approved by the security model.
FINANCITO_ALLOW_PLAINTEXT_SQLITE=0
