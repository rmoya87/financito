# Financito example configuration
# Never commit real values.

FINANCITO_ENV=development
FINANCITO_API_HOST=127.0.0.1
FINANCITO_API_PORT=8000

# Local paths are configured at runtime where possible.
FINANCITO_DB_PATH=
FINANCITO_VAULT_PATH=

# Local AI
LOCAL_LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
LOCAL_LLM_MODEL=
LOCAL_EMBEDDING_MODEL=

# External provider keys: keep empty in git.
BANKING_PROVIDER=
BANKING_CLIENT_ID=
BANKING_CLIENT_SECRET=

MARKET_DATA_PROVIDER=
MARKET_DATA_API_KEY=

CRYPTO_PROVIDER=
CRYPTO_API_KEY=

NEWS_PROVIDER=
NEWS_API_KEY=
